#!/bin/sh
# Restore into a new database and verify business invariants at the backup point.
set -eu
dump=$(realpath "${1:?请指定备份 SQL 文件}")
test -s "$dump"
cd "$(dirname "$0")/.."
restored="delivery_restore_$(date -u +%Y%m%d_%H%M%S)_$$"
sql() {
    docker compose exec -T db sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql -uroot --batch --skip-column-names "$@"' sh "$@"
}
sql -e "CREATE DATABASE \`$restored\` CHARACTER SET utf8mb4"
sql "$restored" < "$dump"
errors=$(sql "$restored" < ops/integrity.sql)
if [ "$errors" != 0 ]; then
    echo "$restored 恢复校验失败，异常项 $errors" >&2
    exit 1
fi
echo "恢复校验通过，数据库 $restored"
